# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# Server
HOST=127.0.0.1
PORT=5000

# Database
DATABASE_URL=sqlite:///crimevision.db

# Storage Paths
UPLOAD_FOLDER=storage/uploads
EVIDENCE_FOLDER=storage/evidence
REPORTS_FOLDER=storage/reports
THUMBNAILS_FOLDER=storage/thumbnails
DERIVED_FOLDER=storage/derived
MAX_UPLOAD_SIZE=524288000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Groq API (Optional - leave empty if not configured)
GROQ_API_KEY=
GROQ_MODEL=

# Object Detection
DETECTION_MODEL=
DETECTION_MODEL_PATH=
DETECTION_CONFIDENCE_THRESHOLD=0.5

# Audio Transcription
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_MODEL_PATH=
ALLOW_MODEL_DOWNLOAD=false

# Image Captioning
CAPTIONING_MODEL=Salesforce/blip-image-captioning-base
CAPTION_MODEL_PATH=

# Video Processing
VIDEO_FRAME_SAMPLE_INTERVAL=30
MAX_VIDEO_DURATION=3600
MAX_VIDEO_FRAMES=120

# Job Processing
MAX_CONCURRENT_JOBS=2
